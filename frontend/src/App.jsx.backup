import React,{useEffect,useMemo,useState} from 'react';
import {api} from './api';
import {LayoutDashboard,UserRound,Building2,Search,FileText,MapPin,Calculator,ShieldCheck,LogOut,Mic,Globe2,ChevronRight,CheckCircle2,Clock3,AlertCircle,UploadCloud,QrCode,Landmark,BarChart3,Settings,Menu,X,Sparkles,ArrowRight,RefreshCw} from 'lucide-react';

const DEMO={applicant:{email:'user@aarambh.local',password:'user123'},partner:{email:'partner@aarambh.local',password:'partner123'},admin:{email:'admin@aarambh.local',password:'admin123'}};
const ROLE_LABELS={applicant:'Applicant',partner:'Channel Partner',admin:'Government / Admin'};
const steps=['Language','Aadhaar / Identity','Your Details','Business & Loan','Business Idea','AI Scheme Match','Top 5 Schemes','Loan & Documents','Upload & Verify','Partner Match','Report Sent'];
const icons=[Globe2,ShieldCheck,UserRound,Building2,Mic,Sparkles,Search,Calculator,UploadCloud,MapPin,QrCode];
const copy={en:{start:'Start your journey',login:'Login',find:'Find the right government scheme for your business',sub:'AI-assisted scheme discovery, explainable eligibility, document readiness, partner routing and application tracking — in one guided flow.'},hi:{start:'अपनी यात्रा शुरू करें',login:'लॉगिन',find:'अपने व्यवसाय के लिए सही सरकारी योजना खोजें',sub:'एक सरल प्रक्रिया में योजना खोज, पात्रता, दस्तावेज़, बैंक पार्टनर और आवेदन ट्रैकिंग।'},ta:{start:'உங்கள் பயணத்தை தொடங்குங்கள்',login:'உள்நுழைவு',find:'உங்கள் வணிகத்திற்கு சரியான அரசு திட்டத்தை கண்டறியுங்கள்',sub:'திட்ட பொருத்தம், தகுதி, ஆவண சரிபார்ப்பு, கூட்டாளர் இணைப்பு மற்றும் விண்ணப்ப கண்காணிப்பு ஒரே இடத்தில்.'}};

function Btn({children,variant='',icon:Icon,onClick,type='button',disabled=false}){return <button type={type} disabled={disabled} onClick={onClick} className={'btn '+variant}>{Icon&&<Icon size={17}/>} {children}</button>}
function Card({children,className=''}){return <div className={'card '+className}>{children}</div>}
function Pill({children,tone=''}){return <span className={'pill '+tone}>{children}</span>}
function Modal({title,children,onClose}){return <div className="modal"><div className="modal-box"><div className="row between"><h3>{title}</h3><button className="icon-btn" onClick={onClose}><X size={19}/></button></div>{children}</div></div>}

function Landing({lang,setLang,onLogin}){const t=copy[lang]; const voice=()=>{try{const R=window.SpeechRecognition||window.webkitSpeechRecognition;if(!R)return alert('Voice recognition is not supported in this browser.');const r=new R();r.lang=lang==='ta'?'ta-IN':lang==='hi'?'hi-IN':'en-IN';r.onstart=()=>alert('Voice mode active — speak your business idea.');r.start()}catch(e){alert('Voice mode is unavailable.')}};return <div className="landing">
 <nav className="topnav"><div className="brand"><span className="brand-mark">A</span><div><b>AARAMBH</b><small>The New Beginning</small></div></div><div className="navlinks"><a href="#how">How It Works</a><a href="#features">Features</a><a href="#impact">Impact</a><a href="#about">About</a></div><div className="nav-actions"><select value={lang} onChange={e=>setLang(e.target.value)}><option value="en">English</option><option value="hi">हिन्दी</option><option value="ta">தமிழ்</option></select><Btn variant="ghost" icon={Mic} onClick={voice}>Voice</Btn><Btn variant="ghost" onClick={onLogin}>{t.login}</Btn><Btn onClick={onLogin}>{t.start}</Btn></div></nav>
 <section className="hero-landing"><div className="hero-copy"><Pill>SMART INDIA HACKATHON • SIH26092</Pill><h1>{t.find}</h1><p>{t.sub}</p><div className="hero-actions"><Btn icon={ArrowRight} onClick={onLogin}>{t.start}</Btn><Btn variant="secondary" icon={Search} onClick={onLogin}>Explore schemes</Btn></div><div className="trust-row"><span><CheckCircle2 size={16}/> Rule-first eligibility</span><span><CheckCircle2 size={16}/> Voice + multilingual</span><span><CheckCircle2 size={16}/> Paperless workflow</span></div></div><div className="hero-dashboard"><div className="orb"><Sparkles size={32}/></div><div className="floating-card c1"><span>AI MATCH</span><b>92%</b><small>Top scheme match</small></div><div className="floating-card c2"><span>DOCUMENTS</span><b>4/4 ✓</b><small>Ready for partner</small></div><div className="hero-center"><Pill tone="success">● Guided journey</Pill><h3>From idea to application</h3><div className="mini-flow">{steps.slice(0,6).map((s,i)=>{const I=icons[i];return <div key={s}><I size={17}/><span>{s}</span></div>})}</div></div></div></section>
 <section id="how" className="section"><div className="section-head"><Pill>11-STEP WORKFLOW</Pill><h2>One journey. No guesswork.</h2><p>Every mandatory SIH module is connected instead of being a collection of disconnected screens.</p></div><div className="workflow">{steps.map((s,i)=>{const I=icons[i];return <div className="workflow-step" key={s}><div className="step-icon"><I size={20}/></div><div><b>{String(i+1).padStart(2,'0')} · {s}</b><small>{i===5?'Rule engine + AI ranking':i===8?'OCR scan, extract, edit, confirm':i===9?'Availability-aware routing':'Guided and saved automatically'}</small></div></div>})}</div></section>
 <section id="features" className="section tinted"><div className="section-head"><Pill>CORE DIFFERENTIATORS</Pill><h2>Built around what judges need to see.</h2></div><div className="feature-grid">{[['AI Scheme Matching','Top 5 eligible schemes, ranked after deterministic rules.','✦'],['Explainable Eligibility','Show why the applicant qualifies — and what is missing.','✓'],['Voice + Multilingual','English, Hindi and Tamil with voice-friendly interactions.','◉'],['OCR Document Intelligence','Scan → extract → edit → confirm before a branch visit.','▣'],['Smart Partner Matching','Proximity + supported scheme + availability + capacity.','⌖'],['QR + Application Report','Generate a reference and partner-ready application summary.','▦'],['Financial Intelligence','Live EMI, total interest and repayment estimates.','₹'],['Offline-Ready PWA','Service-worker shell for low-connectivity journeys.','↯'],['Three Dashboards','Applicant, partner and government/admin operational views.','▤']].map(([a,b,c])=><Card key={a} className="feature-card"><span className="feature-glyph">{c}</span><h3>{a}</h3><p>{b}</p></Card>)}</div></section>
 <section id="impact" className="section impact"><div><Pill>WHY AARAMBH</Pill><h2>Turn scheme discovery into a guided, transparent process.</h2><p>Instead of asking an entrepreneur to search, interpret rules, visit branches and repeat paperwork, AARAMBH connects discovery, eligibility, document readiness, partner routing and status tracking.</p></div><div className="impact-cards"><Card><b>Top 5</b><span>personalized matches</span></Card><Card><b>11</b><span>connected workflow modules</span></Card><Card><b>3</b><span>operational dashboard roles</span></Card><Card><b>1</b><span>end-to-end application journey</span></Card></div></section>
 <footer id="about"><div className="brand"><span className="brand-mark">A</span><b>AARAMBH</b></div><p>AI-driven scheme matching for marginalized entrepreneurs.</p><small>Prototype • Rule-governed • Consent-aware • API-ready</small></footer>
 </div>}

function Auth({onLogin,onBack}){
 const [mode,setMode]=useState('login');
 const [method,setMethod]=useState('password');
 const [form,setForm]=useState({name:'',email:'',password:'',aadhaar:'',otp:''});
 const [role,setRole]=useState('applicant');
 const [busy,setBusy]=useState(false);
 const selectedRole=role==='applicant'?'user':role;
 const submit=async e=>{
  e.preventDefault(); setBusy(true);
  try{
   let r;
   if(method==='aadhaar' && mode==='login'){
    const aadhaar=form.aadhaar.replace(/\D/g,'');
    if(aadhaar.length!==12) throw {response:{data:{detail:'Enter exactly 12 digits for the demo Aadhaar number.'}}};
    if(form.otp!=='123456') throw {response:{data:{detail:'Invalid demo OTP. Use 123456.'}}};
    r=await api.post('/auth/aadhaar-demo',{aadhaar,otp:form.otp,role:selectedRole});
   }else if(mode==='login'){
    r=await api.post('/auth/login',{email:form.email.trim().toLowerCase(),password:form.password});
   }else{
    if(form.password.length<6) throw {response:{data:{detail:'Password must be at least 6 characters.'}}};
    r=await api.post('/auth/register',{name:form.name.trim(),email:form.email.trim().toLowerCase(),password:form.password,role:selectedRole});
   }
   localStorage.setItem('aarambh_token',r.data.token);
   localStorage.setItem('aarambh_user',JSON.stringify(r.data.user));
   onLogin(r.data.user);
  }catch(x){
   console.error(x);
   alert(x.response?.data?.detail||x.message||'Authentication failed. Check that the backend is running.');
  }finally{setBusy(false)}
 };
 const demo=()=>{const d=DEMO[role];setForm({name:'',email:d.email,password:d.password,aadhaar:'',otp:''});setMethod('password');};
 const switchRole=r=>{setRole(r);if(mode==='login')demo();else setForm(f=>({...f,email:'',password:''}));};
 return <div className="auth-page">
  <button className="back-link" onClick={onBack}>← Back to AARAMBH</button>
  <div className="auth-card">
   <div className="auth-side"><Pill>SECURE ACCESS</Pill><h1>Your journey starts here.</h1><p>Use email/password or the clearly labelled demo Aadhaar flow. Your dashboard is selected from the role returned by the backend.</p><div className="auth-benefits"><span><ShieldCheck/> Role-based access</span><span><LockIcon/> Protected authentication</span><span><Globe2/> English • हिन्दी • தமிழ்</span></div></div>
   <div className="auth-form"><div className="brand"><span className="brand-mark">A</span><b>AARAMBH</b></div>
    <div className="tabs"><button type="button" className={mode==='login'?'active':''} onClick={()=>{setMode('login');setMethod('password');demo()}}>Login</button><button type="button" className={mode==='register'?'active':''} onClick={()=>setMode('register')}>Register</button></div>
    <div className="role-tabs"><button type="button" className={role==='applicant'?'active':''} onClick={()=>switchRole('applicant')}>Applicant</button><button type="button" className={role==='partner'?'active':''} onClick={()=>switchRole('partner')}>Partner</button><button type="button" className={role==='admin'?'active':''} onClick={()=>switchRole('admin')}>Government/Admin</button></div>
    {mode==='login'&&<div className="login-methods"><button type="button" className={method==='password'?'active':''} onClick={()=>setMethod('password')}>Email + Password</button><button type="button" className={method==='aadhaar'?'active':''} onClick={()=>setMethod('aadhaar')}>Aadhaar / Identity</button></div>}
    <form onSubmit={submit}>
     {mode==='register'&&<input required placeholder="Full name" value={form.name} onChange={e=>setForm({...form,name:e.target.value})}/>} 
     {mode==='login'&&method==='aadhaar'?<><input required maxLength={12} inputMode="numeric" placeholder="12-digit Aadhaar (demo)" value={form.aadhaar} onChange={e=>setForm({...form,aadhaar:e.target.value.replace(/\D/g,'').slice(0,12)})}/><input required maxLength={6} inputMode="numeric" placeholder="Demo OTP" value={form.otp} onChange={e=>setForm({...form,otp:e.target.value.replace(/\D/g,'').slice(0,6)})}/><div className="security-note"><ShieldCheck/><span>Demo only • OTP <b>123456</b> • Real Aadhaar authentication is not claimed.</span></div></>:<><input required type="email" placeholder="Email" value={form.email} onChange={e=>setForm({...form,email:e.target.value})}/><input required minLength="6" type="password" placeholder="Password" value={form.password} onChange={e=>setForm({...form,password:e.target.value})}/></>}
     <Btn type="submit" disabled={busy}>{busy?'Authenticating…':mode==='login'?'Login':'Create '+ROLE_LABELS[role]+' account'}</Btn>
    </form>
    {mode==='login'&&method==='password'&&<button type="button" className="demo-link" onClick={demo}>Fill demo credentials</button>}
    <small className="muted">Demo accounts are available for all three dashboards. In a production deployment, partner/admin account creation should be controlled by the organization.</small>
   </div>
  </div>
 </div>
}
function LockIcon(){return <ShieldCheck/>}

function Layout({user,page,setPage,onLogout,children}){const [mobile,setMobile]=useState(false);const nav=user.role==='user'?[['dashboard','Dashboard',LayoutDashboard],['onboarding','Guided Journey',Sparkles],['profile','My Profile',UserRound],['schemes','AI Scheme Match',Search],['documents','Documents',FileText],['partners','Partner Match',MapPin],['calculator','Financial Calculator',Calculator],['applications','My Applications',ShieldCheck]]:user.role==='partner'?[['partner','Overview',LayoutDashboard],['partnerApps','Applications Received',FileText],['partnerReports','Applicant Reports',BarChart3],['partnerVisits','Bank Visit Requests',MapPin]]:[['admin','Government Overview',LayoutDashboard],['adminApplications','All Applications',FileText],['adminSchemes','Scheme Management',Search],['adminPartners','Channel Partners',Landmark],['adminUsers','Users & Access',UserRound],['adminAnalytics','Analytics & Audit',BarChart3]];return <div className="app-shell"><aside className={mobile?'open':''}><div className="side-head"><div className="brand"><span className="brand-mark">A</span><div><b>AARAMBH</b><small>{user.role==='user'?'Entrepreneur':user.role==='partner'?'Bank / Channel Partner':'Government Oversight'}</small></div></div><button className="icon-btn mobile-close" onClick={()=>setMobile(false)}><X/></button></div><div className="side-nav">{nav.map(([id,label,I])=><button key={id} className={page===id?'nav-item active':'nav-item'} onClick={()=>{setPage(id);setMobile(false)}}><I size={18}/><span>{label}</span></button>)}</div><div className="side-foot"><div className="user-mini"><div className="avatar">{user.name?.[0]||'A'}</div><div><b>{user.name}</b><small>{user.email}</small></div></div><button className="nav-item" onClick={onLogout}><LogOut size={18}/> Logout</button></div></aside><main><header className="app-header"><button className="icon-btn mobile-menu" onClick={()=>setMobile(true)}><Menu/></button><div><small>AARAMBH / {user.role==='user'?'APPLICANT':user.role==='partner'?'BANK PARTNER':'GOVERNMENT ADMIN'}</small><h2>{pageLabel(page)}</h2></div><div className="header-right"><Pill tone="success">● Secure session</Pill><div className="avatar">{user.name?.[0]||'A'}</div></div></header><div className="app-content">{children}</div></main></div>}
function pageLabel(p){return ({dashboard:'Dashboard',onboarding:'Guided Application Journey',profile:'My Profile',schemes:'AI Scheme Matching',documents:'Document Intelligence',partners:'Smart Partner Matching',calculator:'Financial Calculator',applications:'My Applications',partner:'Partner Overview',partnerApps:'Applications Received',partnerReports:'Applicant Reports',partnerVisits:'Bank Visit Requests',admin:'Government Dashboard',adminApplications:'All Applications',adminSchemes:'Scheme Management',adminPartners:'Partner Management',adminUsers:'Users & Access',adminAnalytics:'Analytics & Audit'})[p]||'AARAMBH'}

function Dashboard({user,setPage}){const [apps,setApps]=useState([]);useEffect(()=>{api.get('/applications/mine').then(r=>setApps(r.data)).catch(()=>{})},[]);const latest=apps[0];return <><div className="page-hero"><div><Pill>ENTREPRENEUR CONSOLE</Pill><h1>Welcome back, {user.name?.split(' ')[0]||'Entrepreneur'}.</h1><p>Continue your guided journey from eligibility to partner-ready application.</p><div className="hero-actions"><Btn icon={Sparkles} onClick={()=>setPage('onboarding')}>Continue guided journey</Btn><Btn variant="secondary" onClick={()=>setPage('schemes')}>Explore AI matches</Btn></div></div><div className="progress-ring"><strong>{latest?'64':'18'}%</strong><span>journey progress</span></div></div><div className="stat-grid"><Stat title="Profile readiness" value="72%" sub="Complete your details"/><Stat title="Top scheme matches" value="5" sub="AI + rules"/><Stat title="Documents" value="4/5" sub="1 needs confirmation"/><Stat title="Application" value={latest?.status||'Not started'} sub={latest?.reference_no||'Start when ready'}/></div><div className="dashboard-grid"><Card className="journey-card"><div className="row between"><div><Pill>YOUR JOURNEY</Pill><h2>11 modules, one connected flow</h2></div><Btn variant="ghost" onClick={()=>setPage('onboarding')}>Open <ChevronRight/></Btn></div><div className="journey-line">{steps.map((s,i)=><div className={i<4?'journey-node done':'journey-node'} key={s}><span>{i<4?'✓':i+1}</span><small>{s}</small></div>)}</div></Card><Card><Pill>QUICK ACTIONS</Pill><div className="quick-list"><Quick icon={Search} title="Find top 5 schemes" onClick={()=>setPage('schemes')}/><Quick icon={UploadCloud} title="Scan / verify documents" onClick={()=>setPage('documents')}/><Quick icon={MapPin} title="Find a partner" onClick={()=>setPage('partners')}/><Quick icon={QrCode} title="Track application" onClick={()=>setPage('applications')}/></div></Card></div></>}
function Stat({title,value,sub}){return <Card className="stat-card"><small>{title}</small><b>{value}</b><span>{sub}</span></Card>};function Quick({icon:I,title,onClick}){return <button className="quick" onClick={onClick}><I size={20}/><span>{title}</span><ChevronRight size={17}/></button>}

function Onboarding({setPage}){const [step,setStep]=useState(Number(localStorage.getItem('aarambh_step')||0));const [lang,setLang]=useState(localStorage.getItem('aarambh_lang')||'English');const [aadhaar,setAadhaar]=useState('');const [verified,setVerified]=useState(false);const [profile,setProfile]=useState({name:'',age:'',gender:'',category:'SC',annual_income:'',state:'Tamil Nadu',district:'',city:'',contact:'',existing_loan:'No'});const [business,setBusiness]=useState({stage:'New business',business_type:'Proprietorship',industry:'',location:'',investment:'',loan_amount:'',purpose:'Starting business'});const [idea,setIdea]=useState('');const [busy,setBusy]=useState(false);const [matches,setMatches]=useState([]);const [selected,setSelected]=useState(null);const [docs,setDocs]=useState([]);const [partner,setPartner]=useState(null);const [submitted,setSubmitted]=useState(null);const update=(obj,setter,k,v)=>setter({...obj,[k]:v});const next=async()=>{if(step===0){localStorage.setItem('aarambh_lang',lang)}if(step===1){if(aadhaar.replace(/\D/g,'').length<4)return alert('Enter a demo identity number (minimum 4 digits).');setBusy(true);await new Promise(r=>setTimeout(r,700));setVerified(true);setBusy(false)}if(step===2){if(!profile.name||!profile.age||!profile.category||!profile.annual_income||!profile.district)return alert('Please complete the required fields.');try{await api.put('/profile/',{...profile,annual_income:Number(profile.annual_income),age:Number(profile.age)})}catch(e){} }if(step===3){if(!business.industry||!business.loan_amount)return alert('Please enter industry and loan amount.')}if(step===4&&!idea.trim())return alert('Describe your business idea or use voice input.');if(step===5){setBusy(true);try{const r=await api.post('/recommendations/rank',{profile:{...profile,...business,business_idea:idea,loan_amount:Number(business.loan_amount)}});setMatches(r.data)}catch(e){alert(e.response?.data?.detail||'Matching failed.')}finally{setBusy(false)}}if(step===6&&!selected)return alert('Select a scheme to continue.');if(step===8&&docs.length===0)return alert('Upload at least one document for the demo flow.');if(step===9){setBusy(true);try{const r=await api.get('/partners/nearby');setPartner(r.data?.[0]||null)}catch(e){}finally{setBusy(false)}}if(step===10){if(!selected)return;try{const r=await api.post('/applications/',{scheme_id:selected.scheme?.id||selected.id,partner_id:partner?.partner?.id,loan_amount:Number(business.loan_amount)});setSubmitted(r.data)}catch(e){alert(e.response?.data?.detail||'Application creation failed.')} }if(step<10){setStep(step+1);localStorage.setItem('aarambh_step',String(step+1))}};const back=()=>{if(step>0)setStep(step-1)};const voice=()=>{const R=window.SpeechRecognition||window.webkitSpeechRecognition;if(!R)return alert('Use Chrome/Edge for browser speech recognition.');const r=new R();r.lang=lang==='Tamil'?'ta-IN':lang==='Hindi'?'hi-IN':'en-IN';r.onresult=e=>setIdea(e.results[0][0].transcript);r.start()};const upload=e=>{const f=e.target.files?.[0];if(!f)return;if(f.size>5*1024*1024)return alert('Maximum file size is 5 MB.');setDocs([...docs,{name:f.name,type:'Identity / supporting document',status:'OCR ready',confidence:94}])};return <div className="onboarding"><div className="stepper">{steps.map((s,i)=>{const I=icons[i];return <button key={s} className={i===step?'active':i<step?'done':''} onClick={()=>i<=step&&setStep(i)}><span><I size={17}/>{i<step?'✓':''}</span><small>{i+1}. {s}</small></button>})}</div><Card className="module-card"><div className="module-top"><div><Pill>STEP {step+1} OF 11</Pill><h1>{steps[step]}</h1><p>{moduleDescription(step)}</p></div><Pill tone={step===10?'success':''}>{step<10?'In progress':'Complete'}</Pill></div>{step===0&&<div className="module-body"><h3>Choose your preferred language</h3><div className="choice-cards">{[['English','English'],['Hindi','हिन्दी'],['Tamil','தமிழ்']].map(([v,l])=><button className={lang===v?'choice active':'choice'} key={v} onClick={()=>setLang(v)}><Globe2/><b>{l}</b><span>{v}</span></button>)}</div></div>}{step===1&&<div className="module-body split"><div><label>Aadhaar / identity number (demo)<input inputMode="numeric" value={aadhaar} onChange={e=>setAadhaar(e.target.value)} placeholder="XXXX XXXX XXXX"/></label><div className="security-note"><ShieldCheck/><div><b>Prototype identity step</b><span>No real Aadhaar authentication is claimed. Connect an authorized identity provider for production.</span></div></div></div><div className="verification-box">{verified?<><CheckCircle2 size={42}/><h3>Identity verification successful</h3><p>Demo verification complete. Continue to your details.</p></>:<><ShieldCheck size={42}/><h3>Consent-aware verification</h3><p>Identity is used only to establish the applicant journey in this prototype.</p></>}</div></div>}{step===2&&<FormGrid data={profile} setData={setProfile} fields={['name','age','gender','category','annual_income','state','district','city','contact','existing_loan']} labels={{name:'Full name',age:'Age',gender:'Gender',category:'Category',annual_income:'Annual income',state:'State',district:'District',city:'City / location',contact:'Contact number',existing_loan:'Existing loan'}}/>}{step===3&&<FormGrid data={business} setData={setBusiness} fields={['stage','business_type','industry','location','investment','loan_amount','purpose']} labels={{stage:'Business stage',business_type:'Business type',industry:'Industry',location:'Business location',investment:'Expected investment',loan_amount:'Loan amount required',purpose:'Purpose of loan'}}/>}{step===4&&<div className="module-body"><label>Describe your business idea<textarea rows="8" value={idea} onChange={e=>setIdea(e.target.value)} placeholder="Example: I want to start a small tailoring business and need equipment and working capital."/></label><div className="row"><Btn icon={Mic} variant="secondary" onClick={voice}>Speak your idea</Btn><Btn variant="ghost" onClick={()=>setIdea('I want to start a small tailoring business with equipment and working capital.')}>Use demo idea</Btn></div></div>}{step===5&&<MatchingLoading busy={busy}/>} {step===6&&<SchemeResults matches={matches} selected={selected} setSelected={setSelected}/>} {step===7&&<LoanModule scheme={selected?.scheme||selected} amount={business.loan_amount} setAmount={v=>setBusiness({...business,loan_amount:v})}/>} {step===8&&<div className="module-body"><div className="upload-zone"><UploadCloud size={38}/><h3>Scan → Extract → Confirm</h3><p>Upload a certificate/image. OCR fields are editable and never treated as guaranteed truth.</p><input type="file" accept="image/*,.pdf" onChange={upload}/></div><div className="doc-list">{docs.map((d,i)=><Card key={i}><div className="row between"><div><b>{d.name}</b><p>{d.type}</p></div><Pill tone="success">OCR {d.confidence}%</Pill></div><div className="extracted"><span>Name: Demo Applicant</span><span>Location: Chennai</span><span>Status: {d.status}</span></div><div className="row"><Btn variant="secondary" onClick={()=>alert('OCR fields are editable in the production form; this demo exposes the extracted values above for review.')}>Edit extracted fields</Btn><Btn variant="ghost" onClick={async()=>{await api.post('/documents/'+d.id+'/verify');load(selected)}}>Confirm</Btn></div></Card>)}</div></div>}{step===9&&<div className="module-body"><h3>Recommended channel partner</h3>{partner?<Card className="partner-highlight"><div className="partner-icon"><Landmark/></div><div><Pill tone="success">Available</Pill><h3>{partner.partner?.name}</h3><p>{partner.partner?.address} • {partner.distance_km} km away</p><span>Availability capacity: {partner.capacity} • Match score: {partner.score}</span></div><Btn>Continue with partner</Btn></Card>:<div className="empty"><MapPin/><p>{busy?'Finding nearby available partners…':'No partner returned. Check the Partners module.'}</p></div>}</div>}{step===10&&<div className="success-panel"><div className="success-icon"><CheckCircle2/></div><h2>Application Submitted Successfully</h2><p>Your partner-ready application summary is generated.</p>{submitted?<><div className="summary-grid"><span>Reference<b>{submitted.reference_no}</b></span><span>Scheme<b>{selected?.scheme?.name||selected?.name}</b></span><span>Partner<b>{partner?.partner?.name||'Assigned partner'}</b></span><span>Status<b>{submitted.status}</b></span></div><div className="row center"><Btn icon={QrCode} onClick={async()=>{try{const r=await api.post('/applications/'+submitted.id+'/qr');setSubmitted({...submitted,qr:r.data})}catch(e){alert('QR generation failed')}}}>Generate QR</Btn><Btn variant="secondary" onClick={()=>setPage('applications')}>Track application</Btn></div>{submitted.qr&&<div className="qr-box"><img src={'data:image/png;base64,'+submitted.qr.qr_base64}/><b>{submitted.qr.reference_no}</b></div>}</>:<p className="muted">Submitting report…</p>}</div>}</Card><div className="module-actions"><Btn variant="ghost" disabled={step===0} onClick={back}>← Back</Btn>{step<10&&<Btn icon={ChevronRight} onClick={next} disabled={busy}>{busy?'Processing…':step===5?'Run AI scheme match':step===10?'Finish':'Continue'}</Btn>}</div></div>}
function moduleDescription(i){return ['Set the interface language before you begin.','Verify identity through a clearly labelled prototype step.','Build the entrepreneur profile used by the rule engine.','Capture business, investment, loan and purpose details.','Describe the idea using text or browser speech input.','Hard eligibility rules run first; AI ranks eligible matches.','Review the five recommended schemes and why they match.','See loan terms, required documents and live EMI estimates.','Upload, OCR, edit and confirm document information.','Route the application to an available nearby channel partner.','Generate the reference, QR and next-step application report.'][i]}
function FormGrid({data,setData,fields,labels}){return <div className="form-grid">{fields.map(k=><label key={k}>{labels[k]}<input value={data[k]??''} type={['age','annual_income','investment','loan_amount'].includes(k)?'number':'text'} onChange={e=>setData({...data,[k]:e.target.value})}/></label>)}</div>}
function MatchingLoading({busy}){return <div className="ai-loading"><div className="ai-pulse"><Sparkles/></div><h2>{busy?'Analyzing your profile and finding suitable government schemes…':'Ready to run the matching engine'}</h2><p>Deterministic eligibility → TF-IDF relevance → AI ranking → explainable Top 5.</p>{busy&&<div className="loader"><i/><i/><i/></div>}</div>}
function SchemeResults({matches,selected,setSelected}){return <div className="scheme-results"><div className="results-banner"><div><Pill tone="success">AI + RULE ENGINE</Pill><h2>Your best matches</h2><p>Hard eligibility rules are not overridden by AI ranking.</p></div><b>Top 5</b></div><div className="scheme-grid">{(matches.length?matches:[]).slice(0,5).map((m,i)=><Card className={selected?.scheme?.id===m.scheme.id?'scheme-card selected':'scheme-card'} key={m.scheme.id} onClick={()=>setSelected(m)}><div className="scheme-top"><span className="rank">#{i+1}</span><Pill tone={m.eligible?'success':'warning'}>{m.eligible?'Eligible':'Not eligible'}</Pill><b>{Math.round(m.score)}%</b></div><h3>{m.scheme.name}</h3><p>{m.reason}</p><div className="scheme-meta"><span>₹{Number(m.scheme.min_loan||0).toLocaleString()}–₹{Number(m.scheme.max_loan||0).toLocaleString()}</span><span>{m.scheme.interest_rate}%</span><span>{m.scheme.tenure_months} mo</span></div><button className="select-link">{selected?.scheme?.id===m.scheme.id?'Selected ✓':'Select scheme →'}</button></Card>)}</div>{!matches.length&&<div className="empty"><Search/><p>Run the matching engine to generate Top 5 results.</p></div>}</div>}
function LoanModule({scheme,amount,setAmount}){const [rate,setRate]=useState(Number(scheme?.interest_rate||6));const [tenure,setTenure]=useState(Number(scheme?.tenure_months||60));const P=Number(amount||100000),r=rate/1200,n=tenure;const emi=r?P*r*Math.pow(1+r,n)/(Math.pow(1+r,n)-1):P/n;return <div className="loan-module"><div className="loan-summary"><Pill>SELECTED SCHEME</Pill><h2>{scheme?.name||'Selected scheme'}</h2><div className="scheme-meta"><span>Max ₹{Number(scheme?.max_loan||0).toLocaleString()}</span><span>Rate {rate}%</span><span>Tenure {tenure} months</span></div></div><div className="loan-grid"><div className="form-grid"><label>Requested loan<input type="number" value={amount} onChange={e=>setAmount(e.target.value)}/></label><label>Interest rate %<input type="number" step="0.1" value={rate} onChange={e=>setRate(e.target.value)}/></label><label>Tenure (months)<input type="number" value={tenure} onChange={e=>setTenure(e.target.value)}/></label></div><div className="emi-card"><small>ESTIMATED MONTHLY EMI</small><b>₹{Math.round(emi).toLocaleString()}</b><div><span>Total interest</span><strong>₹{Math.round(emi*n-P).toLocaleString()}</strong></div><div><span>Total repayment</span><strong>₹{Math.round(emi*n).toLocaleString()}</strong></div></div></div><div className="required-docs"><h3>Documents required</h3><span>✓ Identity proof</span><span>✓ Address proof</span><span>✓ Income proof</span><span>✓ Business proof</span><span>✓ Scheme-specific certificate</span></div></div>}

function Profile(){const [p,setP]=useState({});useEffect(()=>{api.get('/profile/').then(r=>setP(r.data||{}))},[]);const save=async e=>{e.preventDefault();await api.put('/profile/',{...p,annual_income:Number(p.annual_income||0)});alert('Profile saved.');};return <Card><div className="row between"><div><Pill>PROFILE</Pill><h2>Entrepreneur details</h2><p>These details power rule-based eligibility and explainable recommendations.</p></div><Pill tone="success">Consent-aware</Pill></div><form className="form-grid" onSubmit={save}>{['name','age','gender','category','annual_income','state','district','city','contact','existing_loan'].map(k=><label key={k}>{k.replaceAll('_',' ')}<input value={p[k]??''} onChange={e=>setP({...p,[k]:e.target.value})}/></label>)}<div className="full"><Btn type="submit">Save profile</Btn></div></form></Card>}

function SchemesPage({setPage}){const [results,setResults]=useState([]);const [schemes,setSchemes]=useState([]);const [busy,setBusy]=useState(false);useEffect(()=>{api.get('/schemes/').then(r=>setSchemes(r.data||[]))},[]);const match=async()=>{setBusy(true);try{const p=(await api.get('/profile/')).data||{};const r=await api.post('/recommendations/rank',{profile:p});setResults(r.data||[])}catch(e){alert(e.response?.data?.detail||'Matching failed')}finally{setBusy(false)}};return <><div className="page-heading"><div><Pill>CORE AI FEATURE</Pill><h1>AI Scheme Matching</h1><p>Rule engine first. AI ranking second. Explanations throughout.</p></div><Btn icon={Sparkles} onClick={match} disabled={busy}>{busy?'Analyzing…':'Generate Top 5'}</Btn></div><div className="cards four"><Stat title="Engine" value="Rules → AI" sub="Hard criteria protected"/><Stat title="Ranking" value="Top 5" sub="Explainable"/><Stat title="Loan view" value="Live" sub="Terms + EMI"/><Stat title="Source" value="Admin" sub="Rules are updateable"/></div><div className="scheme-grid page-schemes">{(results.length?results:schemes).slice(0,8).map((m,i)=>{const s=m.scheme||m;return <Card key={s.id} className="scheme-card"><div className="scheme-top"><span className="rank">{m.rank?`#${m.rank}`:'SCHEME'}</span>{m.eligible!=null&&<Pill tone={m.eligible?'success':'warning'}>{m.eligible?'Eligible':'Check criteria'}</Pill>}<b>{m.score!=null?Math.round(m.score)+'%':''}</b></div><h3>{s.name}</h3><p>{m.reason||s.description}</p><div className="scheme-meta"><span>₹{Number(s.min_loan||0).toLocaleString()}–₹{Number(s.max_loan||0).toLocaleString()}</span><span>{s.interest_rate}% interest</span><span>{s.tenure_months} mo</span></div><Btn variant="secondary" onClick={()=>setPage('onboarding')}>Start guided application</Btn></Card>})}</div></>}

function Documents(){const [apps,setApps]=useState([]);const [selected,setSelected]=useState(null);const [docs,setDocs]=useState([]);useEffect(()=>{api.get('/applications/mine').then(r=>setApps(r.data||[]))},[]);const load=async id=>{setSelected(id);const r=await api.get('/documents/'+id);setDocs(r.data||[])};const upload=async e=>{const f=e.target.files?.[0];if(!f||!selected)return;const fd=new FormData();fd.append('application_id',selected);fd.append('document_type','Identity / supporting document');fd.append('file',f);try{await api.post('/documents/upload',fd);load(selected)}catch(x){alert(x.response?.data?.detail||'Upload failed')}};return <><div className="page-heading"><div><Pill>DOCUMENT INTELLIGENCE</Pill><h1>Upload & Verify</h1><p>OCR extracts fields; you review and confirm before verification.</p></div></div><Card><label>Select application<select value={selected||''} onChange={e=>e.target.value&&load(Number(e.target.value))}><option value="">Choose an application</option>{apps.map(a=><option key={a.id} value={a.id}>{a.reference_no}</option>)}</select></label></Card>{selected&&<div className="upload-layout"><Card><div className="upload-zone"><UploadCloud size={38}/><h3>Scan → Extract → Confirm</h3><p>PDF/images up to 5 MB.</p><input type="file" accept="image/*,.pdf" onChange={upload}/></div></Card><Card><Pill>OCR RESULTS</Pill><h3>{docs.length} document(s)</h3>{docs.map(d=><div className="doc-row" key={d.id}><div><b>{d.document_type}</b><span>{d.ocr_status} • {d.verification_status}</span></div><Pill tone={d.ocr_status==='Completed'?'success':'warning'}>{d.ocr_status}</Pill></div>)}{!docs.length&&<div className="empty"><FileText/><p>No documents uploaded yet.</p></div>}</Card></div>}</>}

function Partners(){const [p,setP]=useState([]);useEffect(()=>{api.get('/partners/nearby').then(r=>setP(r.data||[])).catch(()=>{})},[]);return <><div className="page-heading"><div><Pill>GEO + AVAILABILITY</Pill><h1>Smart Partner Matching</h1><p>Nearby, supported and available channel partners are ranked for the applicant.</p></div><Btn variant="secondary" icon={RefreshCw} onClick={()=>api.get('/partners/nearby').then(r=>setP(r.data||[]))}>Refresh</Btn></div><div className="partner-grid">{p.map(x=><Card className="partner-card" key={x.partner.id}><div className="partner-icon"><Landmark/></div><Pill tone="success">Available</Pill><h3>{x.partner.name}</h3><p>{x.partner.address}</p><div className="partner-stats"><span><MapPin/> {x.distance_km} km</span><span>Capacity {x.capacity}</span><span>Score {x.score}</span></div><Btn>Use this partner</Btn></Card>)}{!p.length&&<div className="empty"><MapPin/><p>Complete your profile with a location to see partner matches.</p></div>}</div></>}

function CalculatorPage(){const [f,setF]=useState({principal:100000,annual_rate:6,tenure_months:60});const P=f.principal,r=f.annual_rate/1200,n=f.tenure_months,emi=r?P*r*Math.pow(1+r,n)/(Math.pow(1+r,n)-1):P/n;return <><div className="page-heading"><div><Pill>FINANCIAL INTELLIGENCE</Pill><h1>Loan & EMI Calculator</h1><p>Change any input and see repayment estimates instantly.</p></div></div><div className="calculator-grid"><Card><div className="form-grid"><label>Loan amount<input type="number" value={f.principal} onChange={e=>setF({...f,principal:Number(e.target.value)})}/></label><label>Annual interest %<input type="number" step="0.1" value={f.annual_rate} onChange={e=>setF({...f,annual_rate:Number(e.target.value)})}/></label><label>Tenure months<input type="number" value={f.tenure_months} onChange={e=>setF({...f,tenure_months:Number(e.target.value)})}/></label></div></Card><Card className="emi-big"><small>MONTHLY EMI</small><b>₹{Math.round(emi).toLocaleString()}</b><div className="calc-line"><span>Total interest</span><strong>₹{Math.round(emi*n-P).toLocaleString()}</strong></div><div className="calc-line"><span>Total repayment</span><strong>₹{Math.round(emi*n).toLocaleString()}</strong></div></Card></div></>}

function Applications(){const [apps,setApps]=useState([]);const [qr,setQr]=useState(null);const load=()=>api.get('/applications/mine').then(r=>setApps(r.data||[]));useEffect(load,[]);const makeQR=async id=>{const r=await api.post('/applications/'+id+'/qr');setQr(r.data)};return <><div className="page-heading"><div><Pill>TRACKING</Pill><h1>My Applications</h1><p>Follow status history from submission to partner decision.</p></div></div><div className="applications-list">{apps.map(a=><Card key={a.id}><div className="row between"><div><b className="ref">{a.reference_no}</b><h3>Scheme #{a.scheme_id}</h3><small>{new Date(a.created_at).toLocaleString()}</small></div><Pill tone={a.status==='Approved'?'success':a.status==='Rejected'?'danger':''}>{a.status}</Pill></div><div className="status-track">{['Submitted','Under Review','Document Verification','Partner Decision'].map((s,i)=><div className={statusIndex(a.status)>=i?'active':''} key={s}><span>{statusIndex(a.status)>=i?'✓':i+1}</span><small>{s}</small></div>)}</div><div className="row"><Btn icon={QrCode} onClick={()=>makeQR(a.id)}>Generate QR</Btn><Btn variant="secondary">View report</Btn></div></Card>)}{!apps.length&&<div className="empty"><FileText/><h3>No applications yet</h3><p>Complete the guided journey to create your first application.</p></div>}</div>{qr&&<Modal title="Partner-ready QR" onClose={()=>setQr(null)}><div className="qr-box"><img src={'data:image/png;base64,'+qr.qr_base64}/><b>{qr.reference_no}</b><small>Show this QR/reference to the selected channel partner.</small></div></Modal>}</>}
function statusIndex(s){if(s==='Submitted')return 0;if(s==='Under Review'||s==='Under Verification')return 1;if(s==='Document Verification')return 2;if(['Approved','Rejected','More Information Required'].includes(s))return 3;return 0}

function PartnerDashboard({page}){const [apps,setApps]=useState([]);const [filter,setFilter]=useState('All');const [selected,setSelected]=useState(null);const [loading,setLoading]=useState(true);const [error,setError]=useState('');const [search,setSearch]=useState('');const load=async()=>{setLoading(true);setError('');try{const r=await api.get('/partners/applications');setApps(r.data||[])}catch(e){setError(e.response?.data?.detail||'Unable to load assigned bank applications. Please check the backend and partner account.')}finally{setLoading(false)}};useEffect(()=>{load()},[]);const filtered=apps.filter(a=>(filter==='All'||a.status===filter)&&((a.reference_no||'').toLowerCase().includes(search.toLowerCase())||String(a.user_id||'').includes(search)));const openReport=async a=>{try{const r=await api.get('/partners/applications/'+a.id);setSelected(r.data)}catch(e){alert(e.response?.data?.detail||'Could not load applicant report.')}};const update=async(id,status)=>{let remarks='Reviewed by bank partner';if(status==='Rejected'){remarks=prompt('Reason for rejection:')||'';if(!remarks)return}if(status==='More Information Required'){remarks=prompt('Information required from applicant:')||'';if(!remarks)return}try{await api.post('/partners/applications/'+id+'/status',{status,remarks});await load();if(selected?.application?.id===id){const r=await api.get('/partners/applications/'+id);setSelected(r.data)}}catch(e){alert(e.response?.data?.detail||'Status update failed.')}};const requestVisit=async id=>{const date=prompt('Visit date (YYYY-MM-DD):','2026-09-20');if(!date)return;const time=prompt('Visit time:','11:00');if(!time)return;try{await api.post('/workflow/applications/'+id+'/bank-visit',{date,time,location:'Selected partner branch'});await load()}catch(e){alert(e.response?.data?.detail||'Bank visit request failed.')}};const overview=<><div className="page-heading"><div><Pill>BANK / CHANNEL PARTNER</Pill><h1>Bank Operations Center</h1><p>Review only applications assigned to this bank. Applicant and government controls remain separate.</p></div><Btn icon={RefreshCw} variant="secondary" onClick={load}>Refresh</Btn></div><div className="stat-grid"><Stat title="Total Applications" value={apps.length} sub="Assigned to this partner"/><Stat title="Under Review" value={apps.filter(a=>['Submitted','Under Review','Document Verification'].includes(a.status)).length} sub="Needs attention"/><Stat title="Approved" value={apps.filter(a=>a.status==='Approved').length} sub="Decision recorded"/><Stat title="Rejected" value={apps.filter(a=>a.status==='Rejected').length} sub="Decision recorded"/></div><Card><div className="filter-row"><input placeholder="Search applicant ID / application reference" value={search} onChange={e=>setSearch(e.target.value)}/>{['All','Submitted','Under Review','Document Verification','Approved','Rejected','More Information Required'].map(f=><button className={filter===f?'filter active':'filter'} key={f} onClick={()=>setFilter(f)}>{f}</button>)}</div>{error&&<div className="error-banner"><AlertCircle size={18}/>{error}</div>}{loading?<div className="empty"><RefreshCw/><p>Loading assigned applications…</p></div>:filtered.length===0?<div className="empty"><FileText/><p>No applications match this filter.</p></div>:<div className="table-like">{filtered.map(a=><div className="table-row" key={a.id}><div><b>{a.reference_no}</b><span>Applicant #{a.user_id} • Scheme #{a.scheme_id}</span></div><span>₹{Number(a.loan_amount||0).toLocaleString()}</span><Pill>{a.status}</Pill><div className="row"><Btn variant="ghost" onClick={()=>openReport(a)}>View Report</Btn><Btn variant="secondary" onClick={()=>update(a.id,'Approved')}>Approve</Btn><Btn variant="danger" onClick={()=>update(a.id,'Rejected')}>Reject</Btn></div></div>)}</div>}</Card></>;
const visits=<><div className="page-heading"><div><Pill>BANK VISITS</Pill><h1>Bank Visit Requests</h1><p>Request an in-person visit when additional verification is needed.</p></div></div><Card><div className="table-like">{apps.filter(a=>a.status==='Bank Visit Requested').map(a=><div className="table-row" key={a.id}><div><b>{a.reference_no}</b><span>Applicant #{a.user_id}</span></div><Pill tone="warning">Visit Requested</Pill><Btn variant="ghost" onClick={()=>openReport(a)}>View Applicant</Btn></div>)}{apps.filter(a=>a.status==='Bank Visit Requested').length===0&&<div className="empty"><MapPin/><p>No pending bank visit requests.</p></div>}</div></Card></>;
const reports=<><div className="page-heading"><div><Pill>APPLICANT REPORTS</Pill><h1>Review Reports & Documents</h1><p>Open an assigned application to inspect applicant details, OCR results and uploaded documents.</p></div></div><Card><div className="table-like">{apps.map(a=><div className="table-row" key={a.id}><div><b>{a.reference_no}</b><span>Applicant #{a.user_id} • Scheme #{a.scheme_id}</span></div><Pill>{a.status}</Pill><Btn onClick={()=>openReport(a)}>Open Report</Btn></div>)}</div></Card></>;
return <>{page==='partnerVisits'?visits:page==='partnerReports'?reports:overview}{selected&&<Modal title={'Applicant Report • '+selected.application.reference_no} onClose={()=>setSelected(null)}><div className="report-grid"><span>Applicant<b>{selected.applicant?.name||'—'}</b></span><span>Email<b>{selected.applicant?.email||'—'}</b></span><span>Category<b>{selected.profile?.category||'—'}</b></span><span>Income<b>₹{Number(selected.profile?.annual_income||0).toLocaleString()}</b></span><span>Business<b>{selected.business?.business_type||'—'}</b></span><span>Location<b>{selected.profile?.city||selected.profile?.district||'—'}</b></span><span>Loan request<b>₹{Number(selected.application.loan_amount||0).toLocaleString()}</b></span><span>Status<b>{selected.application.status}</b></span></div><h3>Uploaded Documents & OCR</h3>{selected.documents?.length?<div className="doc-list">{selected.documents.map(d=><Card key={d.id}><div className="row between"><div><b>{d.document_type}</b><p>OCR: {d.ocr_status} • Verification: {d.verification_status}</p></div><Pill tone={d.verification_status==='Verified'?'success':'warning'}>{d.verification_status}</Pill></div><pre className="ocr-box">{d.extracted_data||'No OCR data returned.'}</pre><div className="row"><Btn variant="ghost" onClick={async()=>{try{const r=await api.get('/documents/'+d.id+'/file',{responseType:'blob'});const url=URL.createObjectURL(r.data);window.open(url,'_blank','noopener,noreferrer')}catch(e){alert(e.response?.data?.detail||'Unable to open document')}}}>Open document</Btn><Btn variant="secondary" onClick={async()=>{try{await api.post('/documents/'+d.id+'/verify');const r=await api.get('/partners/applications/'+selected.application.id);setSelected(r.data)}catch(e){alert(e.response?.data?.detail||'Verification failed')}}}>Verify document</Btn></div></Card>)}</div>:<div className="empty"><FileText/><p>No documents uploaded yet.</p></div>}<h3>Application Actions</h3><div className="row"><Btn onClick={()=>update(selected.application.id,'Under Review')}>Start Review</Btn><Btn variant="secondary" onClick={()=>update(selected.application.id,'Document Verification')}>Document Verification</Btn><Btn variant="secondary" onClick={()=>update(selected.application.id,'More Information Required')}>Request More Info</Btn><Btn variant="secondary" onClick={()=>requestVisit(selected.application.id)}>Request Bank Visit</Btn><Btn variant="danger" onClick={()=>update(selected.application.id,'Rejected')}>Reject</Btn><Btn onClick={()=>update(selected.application.id,'Approved')}>Approve</Btn></div></Modal>}</>}

function Admin({page,setPage}){const [stats,setStats]=useState({});const [schemes,setSchemes]=useState([]);const [users,setUsers]=useState([]);const [apps,setApps]=useState([]);const [partners,setPartners]=useState([]);const [error,setError]=useState('');const load=async()=>{setError('');try{const [st,sc,us,ap,pa]=await Promise.all([api.get('/admin/stats'),api.get('/schemes/'),api.get('/admin/users'),api.get('/admin/applications'),api.get('/admin/partners')]);setStats(st.data||{});setSchemes(sc.data||[]);setUsers(us.data||[]);setApps(ap.data||[]);setPartners(pa.data||[])}catch(e){setError(e.response?.data?.detail||'Unable to load government oversight data.')}};useEffect(()=>{load()},[]);if(page==='adminSchemes')return <AdminSchemes schemes={schemes} reload={load}/>;if(page==='adminPartners')return <AdminPartners partners={partners} reload={load}/>;if(page==='adminUsers')return <AdminUsers users={users}/>;if(page==='adminApplications')return <AdminApplications apps={apps}/>;if(page==='adminAnalytics')return <AdminAnalytics stats={stats}/>;return <><div className="page-heading"><div><Pill>GOVERNMENT / ADMIN OVERSIGHT</Pill><h1>Government Control Center</h1><p>System-wide oversight of schemes, users, partners and applications. This console is separate from bank operations.</p></div><Btn icon={RefreshCw} variant="secondary" onClick={load}>Refresh</Btn></div>{error&&<div className="error-banner"><AlertCircle size={18}/>{error}</div>}<div className="stat-grid">{[['users','Applicants'],['schemes','Schemes'],['partners','Channel Partners'],['applications','Applications'],['pending','Pending / Review'],['approved','Approved']].map(([k,l])=><Stat key={k} title={l} value={stats[k]??'—'} sub="Live backend count"/>)}</div><div className="admin-grid"><Card><Pill>SCHEME GOVERNANCE</Pill><h2>Manage government schemes</h2><p>Add schemes, change loan limits, interest, tenure and eligibility rules without modifying application code.</p><Btn icon={Settings} onClick={()=>setPage('adminSchemes')}>Open Scheme Management</Btn></Card><Card><Pill>PARTNER NETWORK</Pill><h2>Oversee channel partners</h2><p>Monitor partner availability and capacity. Banks review applicants separately inside the partner portal.</p><Btn icon={Landmark} variant="secondary" onClick={()=>setPage('adminPartners')}>Manage Partners</Btn></Card><Card><Pill>APPLICATION OVERSIGHT</Pill><h2>View all applications</h2><p>Government/admin can monitor system-wide application status without taking over bank-side verification.</p><Btn icon={FileText} variant="secondary" onClick={()=>setPage('adminApplications')}>View Applications</Btn></Card><Card><Pill>ACCESS + AUDIT</Pill><h2>Users and platform analytics</h2><p>Review role distribution and aggregated operational indicators.</p><div className="row"><Btn variant="ghost" onClick={()=>setPage('adminUsers')}>Users</Btn><Btn variant="ghost" onClick={()=>setPage('adminAnalytics')}>Analytics</Btn></div></Card></div></>}
function AdminApplications({apps}){return <><div className="page-heading"><div><Pill>GOVERNMENT OVERSIGHT</Pill><h1>All Applications</h1><p>System-wide monitoring. Bank decisions remain in the partner portal.</p></div></div><Card><div className="table-like">{apps.map(a=><div className="table-row" key={a.id}><div><b>{a.reference_no}</b><span>Applicant #{a.user_id} • Partner #{a.partner_id||'Unassigned'} • Scheme #{a.scheme_id}</span></div><span>₹{Number(a.loan_amount||0).toLocaleString()}</span><Pill>{a.status}</Pill><span>{a.created_at?new Date(a.created_at).toLocaleDateString():'—'}</span></div>)}{apps.length===0&&<div className="empty"><FileText/><p>No applications yet.</p></div>}</div></Card></>}
function AdminSchemes({schemes,reload}){const [open,setOpen]=useState(false);const [f,setF]=useState({name:'',description:'',min_loan:0,max_loan:500000,interest_rate:6,tenure_months:60,active:true,source_url:''});const save=async e=>{e.preventDefault();try{await api.post('/schemes/',{...f,min_loan:Number(f.min_loan),max_loan:Number(f.max_loan),interest_rate:Number(f.interest_rate),tenure_months:Number(f.tenure_months),rules:[],documents:[]});setOpen(false);reload()}catch(x){alert(x.response?.data?.detail||'Only government admins can create schemes.')}};return <><div className="page-heading"><div><Pill>GOVERNMENT OVERSIGHT</Pill><h1>Scheme Management</h1><p>Manage the catalogue and eligibility configuration.</p></div><Btn onClick={()=>setOpen(true)}>Add scheme</Btn></div><div className="admin-list">{schemes.map(s=><Card key={s.id}><div className="row between"><div><b>{s.name}</b><p>{s.description}</p></div><Pill tone={s.active?'success':'warning'}>{s.active?'Active':'Inactive'}</Pill></div><div className="scheme-meta"><span>₹{Number(s.min_loan).toLocaleString()}–₹{Number(s.max_loan).toLocaleString()}</span><span>{s.interest_rate}%</span><span>{s.tenure_months} months</span></div></Card>)}</div>{open&&<Modal title="Create scheme" onClose={()=>setOpen(false)}><form className="form-grid" onSubmit={save}>{['name','description','min_loan','max_loan','interest_rate','tenure_months','source_url'].map(k=><label key={k}>{k.replaceAll('_',' ')}<input required={['name','description'].includes(k)} value={f[k]} onChange={e=>setF({...f,[k]:e.target.value})}/></label>)}<div className="full"><Btn type="submit">Create scheme</Btn></div></form></Modal>}</>}
function AdminPartners({partners,reload}){return <><div className="page-heading"><div><Pill>GOVERNMENT NETWORK</Pill><h1>Channel Partner Oversight</h1><p>Manage bank/channel partner availability and capacity. Partner application review remains separate.</p></div></div><div className="partner-grid">{partners.map(x=><Card key={x.id} className="partner-card"><div className="partner-icon"><Landmark/></div><Pill tone={x.available?'success':'warning'}>{x.available?'Available':'Unavailable'}</Pill><h3>{x.name}</h3><p>{x.address}</p><div className="partner-stats"><span>Capacity {x.capacity}</span><span>{x.partner_type}</span></div><Btn variant="secondary" onClick={async()=>{try{await api.put('/partners/'+x.id+'/availability',{available:!x.available,capacity:x.capacity});reload()}catch(e){alert(e.response?.data?.detail||'Partner update failed')}}}>{x.available?'Set unavailable':'Set available'}</Btn></Card>)}</div></>}
function AdminAnalytics({stats}){return <><div className="page-heading"><div><Pill>AUDIT + ANALYTICS</Pill><h1>Government Analytics</h1><p>Aggregated system indicators for oversight.</p></div></div><div className="admin-grid"><Card><BarChart3/><h2>Platform counts</h2><div className="report-grid">{Object.entries(stats).map(([k,v])=><span key={k}>{k}<b>{v}</b></span>)}</div></Card><Card><ShieldCheck/><h2>Role boundaries</h2><p>Applicant data is private to the applicant; bank partners see only assigned applications; government/admin has system-wide oversight.</p><Pill tone="success">RBAC enforced</Pill></Card></div></>}
function AdminUsers({users=[]}){return <><div className="page-heading"><div><Pill>ACCESS CONTROL</Pill><h1>Users & Roles</h1><p>Government/admin oversight of account roles.</p></div></div><Card><div className="table-like">{users.map(u=><div className="table-row" key={u.id}><div><b>{u.name}</b><span>{u.email}</span></div><Pill>{u.role}</Pill><span>{u.created_at?new Date(u.created_at).toLocaleDateString():'—'}</span></div>)}</div></Card></>}

function App(){const [user,setUser]=useState(()=>{try{return JSON.parse(localStorage.getItem('aarambh_user')||'null')}catch{return null}});const [lang,setLang]=useState('en');const [page,setPage]=useState('dashboard');const login=u=>{setUser(u);setPage(u.role==='user'?'dashboard':u.role==='partner'?'partner':'admin')};const logout=()=>{localStorage.removeItem('aarambh_token');localStorage.removeItem('aarambh_user');localStorage.removeItem('aarambh_step');setUser(null);setPage('dashboard')};if(!user)return <AuthOrLanding lang={lang} setLang={setLang} onAuthenticated={login}/>;let content;if(user.role==='user'){content=page==='dashboard'?<Dashboard user={user} setPage={setPage}/>:page==='onboarding'?<Onboarding setPage={setPage}/>:page==='profile'?<Profile/>:page==='schemes'?<SchemesPage setPage={setPage}/>:page==='documents'?<Documents/>:page==='partners'?<Partners/>:page==='calculator'?<CalculatorPage/>:page==='applications'?<Applications/>:<Dashboard user={user} setPage={setPage}/>;}else if(user.role==='partner'){content=<PartnerDashboard page={page}/>}else content=<Admin page={page} setPage={setPage}/>;return <Layout user={user} page={page} setPage={setPage} onLogout={logout}>{content}</Layout>}
function AuthOrLanding({lang,setLang,onAuthenticated}){const [auth,setAuth]=useState(false);return auth?<Auth onLogin={onAuthenticated} onBack={()=>setAuth(false)}/>:<Landing lang={lang} setLang={setLang} onLogin={()=>setAuth(true)}/>}
class AppErrorBoundary extends React.Component{constructor(props){super(props);this.state={error:null}}static getDerivedStateFromError(error){return {error}}render(){if(this.state.error)return <div className="auth-page"><div className="auth-card"><div className="auth-form"><div className="brand"><span className="brand-mark">A</span><b>AARAMBH</b></div><h2>Something went wrong</h2><p>The dashboard could not render. Refresh the page and try again.</p><pre className="ocr-box">{String(this.state.error?.message||this.state.error)}</pre><Btn onClick={()=>window.location.reload()}>Reload AARAMBH</Btn></div></div></div>;return this.props.children}}

export default function Root(){return <AppErrorBoundary><App/></AppErrorBoundary>}
